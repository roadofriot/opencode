# === Supabase (REQUIRED for auth) ===
# Get these from your Supabase project dashboard: Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# === GitHub API (optional) ===
# GitHub personal access token for repo browsing, gists, etc.
# Generate at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Scopes needed: repo, read:user, user:email
VITE_GITHUB_ACCESS_TOKEN=

# === Firebase (optional) ===
# Used for realtime updates and additional features
# Get from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
