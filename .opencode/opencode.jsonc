{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/llama-3.3-70b-versatile",
  "small_model": "groq/llama-3.1-8b-instant",
  "provider": {
    "groq": {
      "options": {}
    },
    "cerebras": {
      "options": {}
    },
    "deepinfra": {
      "options": {}
    },
    "togetherai": {
      "options": {}
    }
  },
  "enabled_providers": ["groq", "cerebras", "deepinfra", "togetherai"],
  "disabled_providers": [
    "openai",
    "anthropic",
    "google",
    "google-vertex",
    "azure",
    "amazon-bedrock",
    "xai",
    "mistral",
    "cohere",
    "perplexity",
    "vercel",
    "alibaba",
    "nvidia",
    "openrouter",
    "github-copilot",
    "venice-ai-sdk-provider",
    "cloudflare-workers-ai",
    "cloudflare-ai-gateway",
    "snowflake-cortex",
    "mindsparq"
  ],
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
