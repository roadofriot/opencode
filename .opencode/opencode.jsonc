{
  "$schema": "https://opencode.ai/config.json",

  // ─── Default Models ───────────────────────────────────────────────
  "model": "groq/llama-3.3-70b-versatile",
  "small_model": "groq/llama-3.1-8b-instant",

  // ─── Free Providers ───────────────────────────────────────────────
  "provider": {
    "groq": { "options": {} },
    "cerebras": { "options": {} },
    "deepinfra": { "options": {} },
    "togetherai": { "options": {} },
    "nvidia": { "options": {} },
    "openrouter": { "options": {} }
  },

  "enabled_providers": [
    "groq",
    "cerebras",
    "deepinfra",
    "togetherai",
    "nvidia",
    "openrouter"
  ],

  "disabled_providers": [
    "openai",
    "anthropic",
    "google",
    "google-vertex",
    "azure",
    "amazon-bedrock",
    "xai",
    "mistral",
    "cohere",
    "perplexity",
    "vercel",
    "alibaba",
    "github-copilot",
    "venice-ai-sdk-provider",
    "cloudflare-workers-ai",
    "cloudflare-ai-gateway",
    "snowflake-cortex",
    "mindsparq"
  ],

  // ─── Permissions ──────────────────────────────────────────────────
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "bun *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "*": "ask"
    }
  },

  // ─── References ───────────────────────────────────────────────────
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details"
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data"
    }
  },

  // ─── MCP Servers ──────────────────────────────────────────────────
  "mcp": {},

  // ─── Tools ────────────────────────────────────────────────────────
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  },

  // ─── Compaction ───────────────────────────────────────────────────
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },

  // ─── Experimental ─────────────────────────────────────────────────
  "experimental": {
    "primary_tools": ["edit", "bash", "grep", "glob", "read"]
  }
}
